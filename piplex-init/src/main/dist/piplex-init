#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "${JAVA_HOME:-}" ]; then
    java="${JAVA_HOME}/bin/java"
    if [ ! -x "$java" ]; then
        echo "JAVA_HOME does not contain an executable bin/java: ${JAVA_HOME}" >&2
        exit 1
    fi
elif command -v java >/dev/null 2>&1; then
    java=java
else
    echo "Java was not found. Set JAVA_HOME or add java to PATH." >&2
    exit 1
fi

exec "$java" -jar "${script_dir}/piplex-init.jar" "$@"
